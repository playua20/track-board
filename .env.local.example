# Copy to .env.local (gitignored) and fill in from Supabase → Settings → API.
# The same project as the sibling pipeline: one database, this one only reads.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by `npm run db:apply`, which opens a direct Postgres connection
# because Supabase's REST API cannot execute DDL. Not needed at runtime.
SUPABASE_DB_PASSWORD=
